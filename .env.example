# ---------------------------------------------------------------------------
# FRL environment template.
#
# Copy to `.env.local` and fill in real values. `.env.local` is git-ignored and
# MUST NEVER be committed. This file must only ever contain placeholders.
#
# FRL DATA INTEGRITY RULE:
# When a variable below is missing, the affected feature reports an honest
# configuration error. It must NEVER fall back to invented or demo data and
# present it as real.
# ---------------------------------------------------------------------------

# --- Supabase (authentication only) -----------------------------------------
# Read by: src/lib/supabase.ts
# These are publishable / client-safe keys and are intentionally exposed to the
# browser via the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- OpenCorporates (real company registry search + identity) ---------------
# Read by: src/lib/companyRegistry.ts
# Server-side only. NEVER prefix this with NEXT_PUBLIC_.
# When missing, /api/companies/search returns status "not_configured" and
# /api/companies/[id] returns 503 REGISTRY_NOT_CONFIGURED. No company identity
# is ever invented as a substitute.
OPENCORPORATES_API_TOKEN=

# --- AI analysis (optional) --------------------------------------------------
# Read by: src/lib/aiAnalysisService.ts
# When absent, analysis falls back to the deterministic rule-based provider.
GEMINI_API_KEY=

# Optional alias for GEMINI_API_KEY.
LLM_API_KEY=

# --- Chat route (optional) ---------------------------------------------------
# Read by: src/app/api/chat/route.ts
OPENAI_API_KEY=

# --- Not currently required --------------------------------------------------
# SUPABASE_ACCESS_TOKEN is only referenced inside commented-out Supabase MCP
# sample code in src/app/api/chat/route.ts. It is not read at runtime today.
SUPABASE_ACCESS_TOKEN=
